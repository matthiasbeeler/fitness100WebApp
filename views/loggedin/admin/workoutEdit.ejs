        function createJson(){
            //updateWeekconfig
            var weekdays = ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"];
            weekdays.forEach(day => {
                jsonCode.week[day].title = $(`#${day}Title`).val();
