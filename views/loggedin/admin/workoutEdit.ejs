    function chooseImage(image){
        console.log("image: "+image)
        const currentExerciseId = $('.currentId').html();
        $('.'+currentExerciseId).attr('src', "/workoutImages/"+image)
        $('.'+currentExerciseId).parent().children('.filePreview').show();
        console.log($('#imageId'+currentExerciseId).val())
        $('#imageId'+currentExerciseId).val(image);
        console.log("value: "+$('#imageId'+currentExerciseId).val())

        console.log(currentExerciseId)

        $('.imageSelectOverlay').hide()
    }

    function displayImage(input, id) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();

            reader.onload = function (e) {
                
                $('.'+id).attr('src', e.target.result);
                $('.'+id).parent().children('.filePreview').show();
                $('.'+id).parent().children('.filePreview .placeholderText').html('Click to change');
            }

            reader.readAsDataURL(input.files[0]);
        }
        imageUpload(id, input)
    }

      $("form").submit(function(e) {
        e.preventDefault();
        if($('#title').val() == "") return;
        createJson()
       try {
           
           $.ajax({
               url: '/admin/updateWorkout',
               type: 'POST',
               async: false,
               cache: false,
               data: {
                "workoutTitle": $('#title').val(),
                "workoutJson": JSON.stringify(jsonCode),
                "workoutId": workoutData.id
               },
               crossDomain: true,
               success: function (data, status, xhr) {
                   if (data) {

                       if (data.success == true) {
                           $(".submit").val("Success")
                           $(".submit").addClass(`successButton`)
                           $('form').hide();
                           console.log(data)
                           $('#workoutCode, #workoutSuccess, #workoutCodeCopied').show();
                           $('#workoutCode').html(workoutData.workoutCode)
                           $('#workoutCode').attr("onclick", "navigator.clipboard.writeText('"+workoutData.workoutCode+"'); $('#workoutCodeCopied').html('Copied to clipboard')");

                

                       }
                       if (data.success == false) {
                           $(".submit").val("Profilbild updaten")
                           $('.submit').prop('disabled', false);
                           $('.infoContainer').show()
                           $('.infoContainer .info').html(data.message)
                           $(".content").css("opacity", "1");

                           
                       }
                   }

               },
               error: function (jqXHR, textStatus, err) {
                   $(".content").css("opacity", "1");

                   $('.fileInput').show()
                   $('.infoContainer').show()
                   $('.infoContainer .info').html("An error occerd whilst communication with our server.")

                   $(".submit").val("Profilbild updaten")
                   $('.submit').prop('disabled', false);
                   console.log(err)
               }
           });


       } catch (error) {
           console.log(error)
           $(".content").css("opacity", "1");
           $('.infoContainer').show()
           $('.fileInput').show()
           $('.infoContainer .info').html("An error occerd whilst communication with our server.")
           $(".submit").val("Profilbild updaten")
           $('.submit').prop('disabled', false);
       }
   })


   function imageUpload(id, input){
    setTimeout(() => {
        var formData = new FormData();
           formData.append('changeElement', "image")
           formData.append('image', $("."+id).parent().children('#fileInput')[0].files[0]);
           formData.append('id', id);

       try {

           $.ajax({
               url: '/admin/workoutImageUpload/',
               type: 'POST',
               processData: false,
               contentType: false,
               async: false,
               cache: false,
               data: formData,
               crossDomain: true,
               success: function (data, status, xhr) {
                   if (data) {

                       if (data.success == true) {
                           $(".submit").val("Success")
                           $(".submit").addClass(`successButton`)
                          console.log("imageupload ", id, " successful")
                       }
                       if (data.success == false) {
                        
                           $(".submit").val("Profilbild updaten")
                           $('.submit').prop('disabled', false);
                           $('.infoContainer').show()
                           $('.infoContainer .info').html(data.message)
                           $(".content").css("opacity", "1");
                           console.error("imageupload ", id, " errored")

                           
                       }
                   }

               },
               error: function (jqXHR, textStatus, err) {
                   $(".content").css("opacity", "1");

                   $('.fileInput').show()
                   $('.infoContainer').show()
                   $('.infoContainer .info').html("An error occerd whilst communication with our server.")

                   $(".submit").val("Profilbild updaten")
                   $('.submit').prop('disabled', false);
                   console.error("imageupload ", id, " errored")

               }
           });


       } catch (error) {
           console.log(error)
           $(".content").css("opacity", "1");
           $('.infoContainer').show()
           $('.fileInput').show()
           $('.infoContainer .info').html("An error occerd whilst communication with our server.")
           $(".submit").val("Profilbild updaten")
           $('.submit').prop('disabled', false);
           console.error("imageupload ", id, " errored")

