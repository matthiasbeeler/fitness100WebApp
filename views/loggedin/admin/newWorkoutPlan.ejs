function uuidv4() {
  return "10000000-1000-4000-8000-100000000000".replace(/[018]/g, c =>
    (c ^ crypto.getRandomValues(new Uint8Array(1))[0] & 15 >> c / 4).toString(16)
  );
}

console.log();
function renameFile(originalFile, newName) {
    Object.defineProperty(originalFile, 'name', {
  writable: true,
  value: newName
});
}
        function createJson(){
            //updateWeekconfig
            var weekdays = ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"];
            weekdays.forEach(day => {
                jsonCode.week[day].title = $(`#${day}Title`).val();
                jsonCode.week.monday.estimatedTime = $(`.${day} .duration`).val();
            });
            weekdays.forEach(day => {
                var exercises = $(`.${day} .exercisesContainer`).children('.exercise');
                if(exercises.length <= 0) return;
                for (let index = 0; index < exercises.length; index++) {
                    const exercise = exercises[index];
                    var insert = {

                    }
                    insert[$(exercise).children("#exerciseTitle").val()] = {
                        "sets": $(exercise).children("#sets").val(),
                        "description": $(exercise).children(".description").val(),
                        "repetitions": $(exercise).children("#reps").val(),
                        "image": $(exercise).children(".fileInput").children("#fileInput")[0].files[0].name,

                    }
                    jsonCode.workouts[day].push(insert)
                }
                
            });


        }

        function addExercise(day) {
            var obj = `
            <div class="exercise">
            <div class="seperator"></div>
            <div class="spacing5"></div>

