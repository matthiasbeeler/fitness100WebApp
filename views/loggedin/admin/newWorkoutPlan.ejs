    $('.'+day+" .exercisesContainer").append(obj)
    }

    function displayImage(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();

            reader.onload = function (e) {
                $('.filePreview').attr('src', e.target.result);
                $('.filePreview').show();
                $('.fileInput .placeholderText').html('Click to change');
                $('.submitButton').removeClass('subtileButton')
                $('.submitButton').removeClass('grayInnerShadowNoOffset')
                
            }

            reader.readAsDataURL(input.files[0]);
        }
    }
