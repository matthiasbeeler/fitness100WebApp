<%  %>

<!DOCTYPE html>
<html>
  <%- include('../modules/head.ejs', {title: title})%>

  <body>
    <div class="content">
      <%- include('../modules/top.ejs', {title: title, noLogo: true, noBack: false, backLink: "redirect(`/user`)"})%>
      <div class="spacing13"></div>
      
      <div class="innerWorkout">

      </div>
<script>
    var dayName = "<%=title%>";
                          var data =  <%-JSON.stringify(workout[0].excercises) %>;
    if(data.week[dayName].title == ""){
         data.week[dayName].title = "Rest day"
        var obj = `          <div class="workout grayShadowNoOffset">
            <div class="titleH2 info">
          Now it's time to take some well earned rest.
</div>
        </div>

` ; $('.innerWorkout').append(obj)

    }
      $('.titleH1').html(data.week[dayName].title)
      data.workouts[dayName].forEach(element => {
        for (var key in element) {
          var obj = `
          <div class="workout grayShadowNoOffset ${key}">
        <div class="titleH2 info">
          ${key}
</div>
<img src="/workoutImages/${element[key].image}.webp" alt="" loading="lazy">
<div class="titleH4 lightText">
                              ${element[key].description}
                    </div>
                    <div class="titleH4">
                              Do ${element[key].sets}x${element[key].repetitions} repetitions
                    </div>
                  </div>

                    <div class="spacing5"></div>
        `;
        }
        
  $('.innerWorkout').append(obj)
      });
</script>
    </div>
    <%- include('../modules/footer.ejs')%>

  </body>
</html>



<script>
    var backAction;
    function showOverlay() {
        $('.overlay').show();
        backAction = $('.backButton').attr('onclick');
        $('.backButton').attr('onclick', "hideOverlay()")
    }
    function hideOverlay() {
        $('.overlay').hide();
        $('.backButton').attr('onclick', backAction)
    }
   
  </script>