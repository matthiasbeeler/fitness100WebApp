<%  %>

<!DOCTYPE html>
<html>
  <%- include('../modules/head.ejs', {title: title})%>

  <body>
    <div class="content">
      <%- include('../modules/top.ejs', {title: title, noLogo: true, noBack: false, backLink: "redirect(`/user`)"})%>
      <div class="spacing13"></div>
      
      <div class="innerWorkout">

      </div>
<script>
    var dayName = "<%=title%>";
    console.log(dayName)
                          var data =  <%-JSON.stringify(workout[0].excercises) %>;
    if(data.week[dayName] == null){
         data.week[dayName] = "Rest day"
        var obj = `          <div class="workout grayShadowNoOffset">
            <div class="titleH2 info">
          Now it's time to take some well earned rest.
</div>
        </div>

` ; $('.innerWorkout').append(obj)

    }
      $('.titleH1').html(data.week[dayName])
      data.workouts[dayName].forEach(element => {
        for (var key in element) {
          var obj = `
          <div class="workout grayShadowNoOffset ${key}">
        <div class="titleH2 info">
          ${key}
</div>
<img src="${element[key].image}" alt="" loading="lazy">
<div class="titleH4 lightText">
                              ${element[key].description}
                    </div>
                    <div class="titleH4">
                              Do ${element[key].sets}x${element[key].repetitions} repetitions
                    </div>
                  </div>

                    <div class="spacing5"></div>
        `;
        }
        
  $('.innerWorkout').append(obj)
      });
</script>
    </div>
    <%- include('../modules/footer.ejs')%>

  </body>
</html>



<script>
    var backAction;
    function showOverlay() {
        $('.overlay').show();
        backAction = $('.backButton').attr('onclick');
        $('.backButton').attr('onclick', "hideOverlay()")
    }
    function hideOverlay() {
        $('.overlay').hide();
        $('.backButton').attr('onclick', backAction)
    }
    function createEntry(id) {
      $('.errorMessage').hide()
          $(".submit"+id).val("Loading...")
          $('.submit'+id).prop('disabled', true);
          try {
              $.ajax({
                  url: '/user/createEntry',
                  type: 'POST',
                  
                 cache: false,
                 data: {
                     "atelierId": id
                  },
                  xhrFields: {
                      withCredentials: true
                  },
                  crossDomain: true,
                  success: function (data, status, xhr) {
                      if (data) {
                          if (data.success == true) {
                              $(".submit"+id).hide()
                              $('.signedUpParttakers'+id).html("Eingetragene Teilnehmer: "+data.participants);
                              $(".signedUp"+id).show()
                          }
                          if (data.success == false) {
                            console.log(data)
                              $('.infoContainer').show()
                              $('.infoContainer .info').html(data.message)
                              $(".submit"+id).val("Eintragen")
                              $('.submit'+id).prop('disabled', false);
                          }
                      }
  
                  },
                  error: function (jqXHR, textStatus, err) {
                      $('.infoContainer').show()
                      $('.infoContainer .info').html("An error occerd whilst communication with our server.")
  
                      $(".submit"+id).val("Eintragen")
                              $('.submit'+id).prop('disabled', false);
                  }
              });
  
  
          } catch (error) {
              console.log(error)
              $('.infoContainer').show()
              $('.infoContainer .info').html("An error occerd whilst communication with our server.")
              $(".submit"+id).val("Eintragen")
                              $('.submit'+id).prop('disabled', false);
          }
    }
    function removeEntry(id) {
      $('.errorMessage').hide()
          $(".removeEntry"+id).val("Loading...")
          $('.removeEntry'+id).prop('disabled', true);
          try {
              $.ajax({
                  url: '/user/removeEntry',
                  type: 'POST',
                  
                 cache: false,
                 data: {
                     "atelierId": id
                  },
                  xhrFields: {
                      withCredentials: true
                  },
                  crossDomain: true,
                  success: function (data, status, xhr) {
                      if (data) {
                          if (data.success == true) {
                                hideOverlay();
                              $(".submit"+id).show()
                              $('.signedUpParttakers'+id).html("Eingetragene Teilnehmer: "+data.participants);
                              $(".alreadySignedUp, .removeEntryButton").hide()
                          }
                          if (data.success == false) {
                            console.log(data)
                              $('.infoContainer').show()
                              $('.infoContainer .info').html(data.message)
                              $(".removeEntry"+id).val("Ja, abmelden")
                              $('.removeEntry'+id).prop('disabled', false);
                          }
                      }
  
                  },
                  error: function (jqXHR, textStatus, err) {
                      $('.infoContainer').show()
                      $('.infoContainer .info').html("An error occerd whilst communication with our server.")
  
                      $(".removeEntry"+id).val("Ja, abmelden")
                              $('.removeEntry'+id).prop('disabled', false);
                  }
              });
  
  
          } catch (error) {
              console.log(error)
              $('.infoContainer').show()
              $('.infoContainer .info').html("An error occerd whilst communication with our server.")
              $(".removeEntry"+id).val("Ja, abmelden")
                              $('.removeEntry'+id).prop('disabled', false);
          }
    }
  </script>