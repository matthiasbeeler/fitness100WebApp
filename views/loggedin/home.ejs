<% var title="Hallo, " +data.firstName %>

  <!DOCTYPE html>
  <html>
  <%- include('../modules/head.ejs', {title: title})%>

    <body>
      <div class="content">
        <%- include('../modules/top.ejs', {title: title, noLogo: true, noBack: true, backLink: "redirect(`/`)" })%>
          <div class="accountIcon" onclick="redirect(`/user/account/`)">
            <img src="/images/accountIcon.svg" alt="">
          </div>
          <div class="spacing5"></div>
          <div class="infoContainer redInnerShadowNoOffset" style="display: none;">
            <div class="titleH4 info">

            </div>
          </div>
          <p class="dateDebug">

          </p>
          <% if(data.admin==true){%>
            <% if(inactives==true){%>

              <!--<input type="submit" onclick="redirect('/admin/participants')"
                class="subtileButton submitButton orangeShadowNoOffset button submit" value="Es gibt blockierte Nutzer">
              <div class="spacing5"></div>-->
              <%}%>

                <div onclick="redirect('/admin')" class="smallSubmitText submitButton submitDiv">
                  Verwaltung
                </div>
                <div class="spacing5"></div>
                <%}%>

                  <div class="spacing5"></div>
                  <div class="workoutContent">
                   <div class="workoutOverlay">
                    <div class="backButton" onclick="$(this).parent().hide()">
                      <img class="svgWhite" src="/images/back.svg" alt="">
                  </div>
                  <div class="titleH1 title actualTitle">
                    
                  </div>
                  <div class="spacing5"></div>
                  <div class="innerOverlay">

                  </div>
                   </div>
                    <% function getDayName(dateStr, locale) { var date=new Date(dateStr); return
                      date.toLocaleDateString(locale, { weekday: 'long' }); } %>

                      <% if(workout.length> 0) { %>

                        <script>
                          function capitalize(string) {
    return string.charAt(0).toUpperCase() + string.slice(1).toLowerCase();
}
                          var days = {
                            "monday": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"],
                            "tuesday": ["tuesday", "wednesday", "thursday", "friday", "saturday", "sunday", "monday"],
                            "wednesday": ["wednesday", "thursday", "friday", "saturday", "sunday", "monday", "tuesday"],
                            "thursday": ["thursday", "friday", "saturday", "sunday", "monday", "tuesday", "wednesday"],
                            "friday": ["friday", "saturday", "sunday", "monday", "tuesday", "wednesday", "thursday"],
                            "saturday": ["saturday", "sunday", "monday", "tuesday", "wednesday", "thursday", "friday"],
                            "sunday": ["sunday", "monday", "tuesday", "wednesday", "thursday", "friday", "saturday"]
                          }

                          var date = new Date();
                          var dayName =  date.toLocaleDateString("ch-EN", { weekday: 'long' }).toLowerCase();
                          var data =  <%-JSON.stringify(workout[0].excercises) %>;
                          $('.dateDebug').html(dayName+JSON.stringify(days))
                          days[dayName].forEach(element => {
                            var title = data.week[element].title;
                            var hide;
                            if(title == "") hide = "hidden";
                            if(title == "") title = "Rest day"
                            var obj = `
                            <div class="titleH4 placeholderColour">
                              ${capitalize(element)}
                    </div>
                    <div class="spacing5"></div>

                            <div class="atelierContainer ${element}  grayShadowNoOffset">
          <div class="aterlierTitle titleH3 titleNoMargin">
            ${title}
          </div>
          
          <div class="infoList">
          </div>
        <div class="timeEstimate ${hide}">
          <p>Estimated time:</p>
          <div class="aterlierTitle titleH3 titleNoMargin">
            ${data.week[element].estimatedTime}
          </div>
        </div>

          <div class="smallSubmitText submitButton submitDiv" onclick="window.location = '/user/${element}'">
           Show more
          </div>

        </div>
        <div class="spacing10"></div>
        `
        $('.workoutContent').append(obj)
        var workout = ""
        data.workouts[element].forEach(element => {
          for (var key in element) {
          workout = workout + `<li>${key}  -  ${element[key].sets}x${element[key].repetitions} </li>`
        }
        });
        $('.titleH4.placeholderColour').first().html('Today')
        if(title == "Rest day") $('.'+element+' .submitButton').hide()
        $('.atelierContainer.'+element+' .infoList').append(workout)
                          });
                        </script>
                        
                        <% } else {%>
                          <div class="textH2 title ">
                            Du hast noch kein Workout-Code. <br> Kontaktiere uns, damit wir Dir einen personalisierten Workout-Plan erstellen können!
                          </div>
                        <% } %>


                  </div>
      </div>
      <%- include('../modules/footer.ejs')%>
    </body>
  </html>
